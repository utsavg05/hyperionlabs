{
  "site": {
    "title": "Hyperion Labs",
    "base_url": "https://astroplate.netlify.app",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/favicon.png",
    "logo": "",
    "logo_darkmode": "",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Hyperion Labs"
  },

  "settings": {
    "search": false,
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "light",
    "pagination": 2,
    "summary_length": 200,
    "blog_folder": "blog"
  },


  "announcement": {
    "enable": false,
    "content": "",
    "expire_days": 7
  },


  "params": {
    "contact_form_action": "#",
    "copyright": "Engineering the backbone of modern operations."
  },

  "brochure_button": {
    "enable": true,
    "label": "Brochure",
    "link": "/images/brochure.pdf"
  },

  "navigation_button": {
    "enable": true,
    "label": "Contact",
    "link": "/contact"
  },



  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": true,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "zeon.studio",
    "meta_image": "/images/og-image.png",
    "meta_description": "astro and tailwind boilerplate"
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
    "generate_individual_md": true,
    "include": [],
    "exclude": []
  }
}
