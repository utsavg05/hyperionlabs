---
import ImageMod from "@/components/ImageMod.astro";
import GridBackgroundDemo from "../components/grid-background-demo";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Testimonial from "@/partials/Testimonial.astro";
import FAQ from "@/partials/FAQ.astro";
import FeaturedProducts from "@/partials/FeaturedProducts.astro";
import IndustriesAndTeam from "@/partials/IndustriesAndTeam.astro";
import RDInnovation from "@/partials/RDInnovation.astro";
import TrustedBy from "@/partials/TrustedBy.astro";
import WhatWeBuild from "@/partials/WhatWeBuild.astro";
import { FaCheck } from "react-icons/fa";

const homepage = await getListPage("homepage", "-index");
const call_to_action = await getListPage("ctaSection", "call-to-action");
const testimonial = await getListPage("testimonialSection", "testimonial");

const { banner, features } = homepage.data;
---

<Base>
  <!-- Banner -->
  <section class="hero-section relative min-h-[80vh] overflow-hidden">
    <GridBackgroundDemo className="absolute inset-0 min-h-[80vh]" />
    <div class="container relative z-10 flex min-h-[80vh] items-center justify-center">
      <div class="row w-full justify-center">
        <div class="col-12 mx-auto max-w-5xl text-center">
          <h1
            set:html={markdownify(banner.title)}
            class="hero-title font-primary mb-6 font-semibold tracking-tight text-text-dark dark:text-darkmode-text-dark"
          />
          <p
            set:html={markdownify(banner.content)}
            class="hero-subtitle font-primary text-text dark:text-darkmode-text mx-auto mb-10 max-w-3xl"
          />
          {
            banner.button.enable && (
              <a
                class="btn btn-primary"
                href={banner.button.link}
                target={
                  banner.button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel={
                  banner.button.link.startsWith("http") ? "noopener" : undefined
                }
              >
                {banner.button.label}
              </a>
            )
          }
        </div>
        {
          banner.image && (
            <div class="col-12 mt-12">
              <ImageMod
                src={banner.image}
                height={380}
                width={1200}
                alt="banner"
                format="webp"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
  <!-- /Banner -->

  <TrustedBy />
  <WhatWeBuild />
  <FeaturedProducts />
  <RDInnovation />
  <IndustriesAndTeam />

  <!-- Features -->
  
  <!-- /Features -->

  <Testimonial testimonial={testimonial} />
  <FAQ />
</Base>
