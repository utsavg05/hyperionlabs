---
const metrics = [
  { value: "120+", label: "Projects Delivered", icon: "projects" },
  { value: "60+", label: "Enterprise Clients", icon: "clients" },
  { value: "99.9%", label: "System Reliability", icon: "reliability" },
  { value: "15+", label: "Industries Served", icon: "industries" },
] as const;

const clients = [
  { name: "Country Delight", logo: "/images/clients/country-delight.png" },
  { name: "CityMall", logo: "/images/clients/citymall.png" },
  { name: "DealShare", logo: "/images/clients/dealshare.png" },
  { name: "bigbasket", logo: "/images/clients/bigbasket.png" },
  { name: "Tata 1mg", logo: "/images/clients/tata-1mg.png" },
  { name: "Urban Harvest", logo: "/images/clients/urban-harvest.png" },
  { name: "Zepto", logo: "/images/clients/zepto.png" },
];
---

<section class="hero-premium" aria-labelledby="hero-heading">
  <div class="container relative z-10">
    <!-- Copy block -->
    <div class="hero-copy">
      <p class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Enterprise Software Solutions
      </p>

      <h1 id="hero-heading" class="hero-heading">
        Engineering the<br class="hidden sm:block" />
        backbone of<br class="hidden sm:block" />
        modern operations.
      </h1>

      <p class="hero-lede">
        Enterprise software for inventory, warehouses, fleet management,
        rentals, and order fulfillment — built to help businesses move faster
        with complete operational visibility.
      </p>

      <div class="hero-ctas">
        <a href="/#portfolio" class="hero-btn hero-btn-primary">
          Explore Our Work
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a href="/contact" class="hero-btn hero-btn-secondary">Talk to Us</a>
      </div>
    </div>

    <!-- Hero visual — light / dark variants, seamless -->
    <div class="hero-visual">
      <img
        src="/images/hero.png"
        alt="Hyperion Labs operations platform — inventory, warehouse, fleet, rental, and order management"
        width="1600"
        height="900"
        class="hero-visual-img dark:hidden"
        decoding="async"
        fetchpriority="high"
      />
      <img
        src="/images/hero-dark.png"
        alt="Hyperion Labs operations platform — inventory, warehouse, fleet, rental, and order management"
        width="1600"
        height="900"
        class="hero-visual-img hidden dark:block"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <!-- Metrics -->
    <div class="hero-metrics">
      {
        metrics.map((metric) => (
          <div class="hero-metric">
            <span class="hero-metric-icon" aria-hidden="true">
              {metric.icon === "projects" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
                  <path d="M12 22V12" />
                  <path d="m3.3 7 8.7 5 8.7-5" />
                </svg>
              )}
              {metric.icon === "clients" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                  <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                  <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                  <path d="M10 6h4" />
                  <path d="M10 10h4" />
                  <path d="M10 14h4" />
                  <path d="M10 18h4" />
                </svg>
              )}
              {metric.icon === "reliability" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                  <path d="m19 9-5 5-4-4-3 3" />
                </svg>
              )}
              {metric.icon === "industries" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                  <path d="M2 12h20" />
                </svg>
              )}
            </span>
            <div>
              <p class="hero-metric-value">{metric.value}</p>
              <p class="hero-metric-label">{metric.label}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trusted by -->
    <div class="hero-trusted">
      <p class="hero-trusted-label">Trusted by businesses globally</p>
      <div class="hero-trusted-logos">
        {
          clients.map((client) => (
            <div class="hero-trusted-item" title={client.name}>
              <img
                src={client.logo}
                alt={client.name}
                width="120"
                height="40"
                loading="lazy"
                decoding="async"
                class="hero-trusted-img"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
