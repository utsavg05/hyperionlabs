---
const nodes = [
  {
    id: "inventory",
    title: "Inventory Management",
    position: "top-left",
    icon: "inventory",
  },
  {
    id: "orders",
    title: "Order & Delivery Management",
    position: "mid-left",
    icon: "orders",
  },
  {
    id: "warehouse",
    title: "Warehouse Management",
    position: "bottom",
    icon: "warehouse",
  },
  {
    id: "fleet",
    title: "Fleet Management",
    position: "top-right",
    icon: "fleet",
  },
  {
    id: "rental",
    title: "Rental Management",
    position: "mid-right",
    icon: "rental",
  },
] as const;

const metrics = [
  { value: "120+", label: "Projects Delivered", icon: "projects" },
  { value: "60+", label: "Enterprise Clients", icon: "clients" },
  { value: "99.9%", label: "System Reliability", icon: "reliability" },
  { value: "15+", label: "Industries Served", icon: "industries" },
] as const;

const clients = [
  { name: "Country Delight", logo: "/images/clients/country-delight.png" },
  { name: "CityMall", logo: "/images/clients/citymall.png" },
  { name: "DealShare", logo: "/images/clients/dealshare.png" },
  { name: "bigbasket", logo: "/images/clients/bigbasket.png" },
  { name: "Tata 1mg", logo: "/images/clients/tata-1mg.png" },
  { name: "Urban Harvest", logo: "/images/clients/urban-harvest.png" },
  { name: "Zepto", logo: "/images/clients/zepto.png" },
];
---

<section class="hero-premium" aria-labelledby="hero-heading">
  <!-- faint technical grid -->
  <div class="hero-grid-bg" aria-hidden="true"></div>

  <div class="container relative z-10">
    <!-- Copy block -->
    <div class="hero-copy">
      <p class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Enterprise Software Solutions
      </p>

      <h1 id="hero-heading" class="hero-heading">
        Engineering the<br class="hidden sm:block" />
        backbone of<br class="hidden sm:block" />
        modern operations.
      </h1>

      <p class="hero-lede">
        Enterprise software for inventory, warehouses, fleet management,
        rentals, and order fulfillment — built to help businesses move faster
        with complete operational visibility.
      </p>

      <div class="hero-ctas">
        <a href="/#portfolio" class="hero-btn hero-btn-primary">
          Explore Our Work
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
        <a href="/contact" class="hero-btn hero-btn-secondary">Talk to Us</a>
      </div>
    </div>

    <!-- Architecture visual -->
    <div class="hero-viz" aria-hidden="true">
      <!-- SVG connector lines -->
      <svg class="hero-connectors" viewBox="0 0 900 520" fill="none">
        <!-- left branch -->
        <path
          class="hero-line"
          d="M450 250 L280 140 L180 110"
          stroke-dasharray="4 6"></path>
        <path
          class="hero-line"
          d="M450 250 L260 280 L160 300"
          stroke-dasharray="4 6"></path>
        <!-- bottom -->
        <path
          class="hero-line"
          d="M450 250 L450 400"
          stroke-dasharray="4 6"></path>
        <!-- right branch -->
        <path
          class="hero-line"
          d="M450 250 L620 140 L720 110"
          stroke-dasharray="4 6"></path>
        <path
          class="hero-line"
          d="M450 250 L640 280 L740 300"
          stroke-dasharray="4 6"></path>
      </svg>

      <!-- floating nodes -->
      {
        nodes.map((node) => (
          <div class={`hero-node hero-node--${node.position}`}>
            <div class="hero-node-card">
              <span class="hero-node-icon">
                {node.icon === "inventory" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                    <path d="m3.3 7 8.7 5 8.7-5" />
                    <path d="M12 22V12" />
                  </svg>
                )}
                {node.icon === "orders" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 3h5v5" />
                    <path d="m21 3-6.5 6.5" />
                    <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
                    <path d="M8 14h.01" />
                    <path d="M12 14h.01" />
                    <path d="M16 14h.01" />
                    <path d="M8 18h.01" />
                    <path d="M12 18h.01" />
                    <path d="M16 18h.01" />
                  </svg>
                )}
                {node.icon === "warehouse" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35A2 2 0 0 1 3.26 6.5l8-3.2a2 2 0 0 1 1.48 0l8 3.2A2 2 0 0 1 22 8.35Z" />
                    <path d="M6 18h12" />
                    <path d="M6 14h12" />
                  </svg>
                )}
                {node.icon === "fleet" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
                    <path d="M15 18H9" />
                    <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" />
                    <circle cx="17" cy="18" r="2" />
                    <circle cx="7" cy="18" r="2" />
                  </svg>
                )}
                {node.icon === "rental" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                    <path d="M12 11h4" />
                    <path d="M12 16h4" />
                    <path d="M8 11h.01" />
                    <path d="M8 16h.01" />
                  </svg>
                )}
              </span>
              <span class="hero-node-title">{node.title}</span>
            </div>
          </div>
        ))
      }

      <!-- central platform -->
      <div class="hero-core">
        <div class="hero-core-shadow"></div>
        <div class="hero-core-platform">
          <div class="hero-core-face hero-core-face--top"></div>
          <div class="hero-core-face hero-core-face--front">
            <span class="hero-core-mark">H</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Metrics -->
    <div class="hero-metrics">
      {
        metrics.map((metric) => (
          <div class="hero-metric">
            <span class="hero-metric-icon" aria-hidden="true">
              {metric.icon === "projects" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
                  <path d="M12 22V12" />
                  <path d="m3.3 7 8.7 5 8.7-5" />
                </svg>
              )}
              {metric.icon === "clients" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                  <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                  <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                  <path d="M10 6h4" />
                  <path d="M10 10h4" />
                  <path d="M10 14h4" />
                  <path d="M10 18h4" />
                </svg>
              )}
              {metric.icon === "reliability" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 3v16a2 2 0 0 0 2 2h16" />
                  <path d="m19 9-5 5-4-4-3 3" />
                </svg>
              )}
              {metric.icon === "industries" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                  <path d="M2 12h20" />
                </svg>
              )}
            </span>
            <div>
              <p class="hero-metric-value">{metric.value}</p>
              <p class="hero-metric-label">{metric.label}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Trusted by -->
    <div class="hero-trusted">
      <p class="hero-trusted-label">Trusted by businesses globally</p>
      <div class="hero-trusted-logos">
        {
          clients.map((client) => (
            <div class="hero-trusted-item" title={client.name}>
              <img
                src={client.logo}
                alt={client.name}
                width="120"
                height="40"
                loading="lazy"
                decoding="async"
                class="hero-trusted-img"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
